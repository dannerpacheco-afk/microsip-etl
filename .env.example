# --- Microsip API ---
MICROSIP_API_URL=http://192.168.1.100:8000/api/v1
MICROSIP_API_KEY=your-api-key-here

# --- Google Cloud ---
GCP_PROJECT_ID=microsip-analytics
BQ_DATASET=microsip
BQ_LOCATION=us-central1

# --- ETL behavior ---
PAGE_SIZE=500
MAX_PAGES=10000
INITIAL_LOOKBACK_DAYS=30
LOG_LEVEL=INFO
