# --- Microsip API ---
# On the API server with network_mode: host this is localhost:8000.
MICROSIP_API_URL=http://localhost:8000/api/v1
MICROSIP_API_KEY=your-api-key-here
# Sent as X-Empresa and stored in every row as EMPRESA
MICROSIP_EMPRESA=ALMACENES PACHECO

# --- Google Cloud ---
GCP_PROJECT_ID=lookerstudio-microsip-508301
BQ_DATASET=microsip
BQ_DATASET_PROVEEDORES=microsip_proveedores
BQ_LOCATION=us-central1
# Service account key (roles/bigquery.dataEditor + roles/bigquery.jobUser).
# Leave unset to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# --- History window ---
# Empty = today minus BACKFILL_YEARS (rolling 3 years)
BACKFILL_START_DATE=
BACKFILL_YEARS=3
# Nightly runs recompute the last N days (cancellations, late returns)
ROLLING_WINDOW_DAYS=45
# Backfill chunk sizes (days). ventas-articulo ~19 s per 7 days.
VENTAS_CHUNK_DAYS=7
COMPRAS_CHUNK_DAYS=31

# --- Retention (BigQuery partition expiration, days) ---
RETENTION_DAYS_FACTS=1100
RETENTION_DAYS_SNAPSHOTS=400

# --- Suppliers that get their own authorized views (PROVEEDOR_ID list) ---
PROVEEDORES_BI=

# --- Sales-format mapping (regex over TIPOS_CLIENTES.NOMBRE → FORMATO) ---
# Edit the CSV to change the mapping; loaded into dim_formato_venta every run.
FORMATOS_VENTA_CSV=config/formatos_venta.csv

# --- Monthly ISCAM report e-mail (optional; sent only if HOST, FROM and TO are set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients
REPORTE_ISCAM_TO=

# --- ETL behavior ---
PAGE_SIZE=500
BULK_PAGE_SIZE=5000
MAX_PAGES=10000
REQUEST_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO
